{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "jenkins-try1-cluster-prod",
    "containerDefinitions": [
        {
            "name": "jenkins-try1",
            "image": "059310317881.dkr.ecr.us-east-1.amazonaws.com/myjenkins-try:1.0.89",
            "portMappings": [
                {   
                    "name": "nginx",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512",
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::059310317881:role/ecsTaskExecutionRole"
}